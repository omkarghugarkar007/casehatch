  "clarification": {
    "questionLimit": 3,
    "questionsAsked": 2,
    "decisions": [
      {
        "id": "DEC-001",
        "question": "Should one invalid row reject the whole batch, or should valid rows be imported?",
        "answer": "Reject the whole batch. Return row errors and persist no customer rows.",
        "basis": [
          "SRC-BRD#BR-03",
          "SRC-PRD#PR-04",
          "SRC-TICKET#Clarification needed"
        ],
        "state": "illustrative_developer_answer"
      },
      {
        "id": "DEC-002",
        "question": "After a timeout, what should a retry with the same idempotency key return?",
        "answer": "Return the existing job ID with HTTP 200. Do not create another job or import. A new-key duplicate-content request still follows PR-02.",
        "basis": [
          "SRC-BRD#BR-02",
          "SRC-PRD#PR-04",
          "SRC-TICKET#Clarification needed"
        ],
        "state": "illustrative_developer_answer"
      }
    ]
