{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "featureId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "scopeRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "changeReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "scopeChange": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "provenance": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        }
      },
      "required": ["reason", "provenance"],
      "additionalProperties": false
    },
    "brief": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        }
      },
      "required": ["goal", "actors", "rules", "exclusions"],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": ["id", "sha256"],
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "provenance": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            }
          }
        },
        "required": ["id", "question", "provenance"],
        "additionalProperties": false
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "scope": {
            "type": "string",
            "enum": ["required", "candidate", "deferred", "excluded"]
          },
          "provenance": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            }
          },
          "requiredCaseIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        },
        "required": ["id", "title", "scope", "provenance", "requiredCaseIds"],
        "additionalProperties": false
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "expectedOutcome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "provenance": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            }
          },
          "binding": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*\\/$)[^\\u0000]+$"
              },
              "projects": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 100
                }
              }
            },
            "required": ["file", "projects"],
            "additionalProperties": false
          },
          "assertions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                }
              },
              "required": ["id", "description"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "expectedOutcome",
          "provenance",
          "binding",
          "assertions"
        ],
        "additionalProperties": false
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      }
    },
    "deferredConcerns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "acknowledged": {
            "type": "boolean"
          }
        },
        "required": ["id", "title", "reason", "acknowledged"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "featureId",
    "title",
    "scopeRevision",
    "brief",
    "sources",
    "decisions",
    "obligations",
    "cases",
    "unresolved",
    "conflicts",
    "deferredConcerns"
  ],
  "additionalProperties": false
}
